#!/bin/sh
# 提交前把暂存文件里的 CRLF 归一成 LF（工作区 + 索引都改）。
#
# 为什么需要：Python 的 Path.write_text() 在 Windows 上会把 \n 写成 \r\n，
# 于是"只改一行"的文件在 diff 里可能整篇重写。.gitattributes 能保证**仓库里**
# 始终是 LF，但工作区会留着 CRLF 并让 git 每次打警告；这个 hook 在提交前
# 就把工作区也修好，从源头断掉。
#
# 逻辑在 .githooks/normalize_eol.py 里（本项目禁止用 sed -i 处理中文文件）。

ROOT=$(git rev-parse --show-toplevel) || exit 0
PY="$ROOT/.venv/Scripts/python.exe"
[ -x "$PY" ] || PY="$ROOT/.venv/bin/python"
[ -x "$PY" ] || PY=python

exec "$PY" "$ROOT/.githooks/normalize_eol.py"
